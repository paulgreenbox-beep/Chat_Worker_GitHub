 pub fn private_temp_dir(label: &str) -> PathBuf {
-    assert!(!label.is_empty() && label.len() <= 32 && label.bytes().all(|b| b.is_ascii_alphanumeric() || b"-_".contains(&b)));
-    let root = std::env::temp_dir().join(format!("cwg-{label}-{}-{}-{}", std::process::id(),
-        SystemTime::now().duration_since(UNIX_EPOCH).unwrap().as_nanos(), NONCE.fetch_add(1, Ordering::Relaxed)));
+    assert!(
+        !label.is_empty()
+            && label.len() <= 32
+            && label
+                .bytes()
+                .all(|b| b.is_ascii_alphanumeric() || b"-_".contains(&b))
+    );
+    // Test location selection only: runtime ACL policy is always enforced.
+    // This permits an explicitly approved fresh fixture below safe ancestors
+    // when the host's default TEMP chain itself has unsafe application grants.
+    let parent = std::env::var_os("CWG_NATIVE_FIXTURE_PARENT").map(PathBuf::from)
+        .unwrap_or_else(std::env::temp_dir);
+    assert!(parent.is_absolute() && !parent.components().any(|component| matches!(component, Component::ParentDir | Component::CurDir)));
+    for ancestor in parent.ancestors() {
+        let metadata = fs::symlink_metadata(ancestor).expect("fixture parent must exist");
+        assert!(!metadata.file_type().is_symlink() && metadata.file_attributes() & 0x400 == 0,
+            "fixture parent chain cannot contain reparse aliases");
+    }
+    let root = parent.join(format!(
+        "cwg-{label}-{}-{}-{}",
+        std::process::id(),
+        SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .unwrap()
+            .as_nanos(),
+        NONCE.fetch_add(1, Ordering::Relaxed)
+    ));
     fs::create_dir(&root).expect("create new owned synthetic fixture");
-    ROOTS.get_or_init(|| Mutex::new(Vec::new())).lock().unwrap().push(root.clone());
+    ROOTS
+        .get_or_init(|| Mutex::new(Vec::new()))
+        .lock()
+        .unwrap()
+        .push(root.clone());
     set_fixture_acl(&root, None).expect("apply actual owner-private ACL to synthetic fixture");
     root
 }
 
